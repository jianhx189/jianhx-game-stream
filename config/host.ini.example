; =============================================================================
;  MiniStream 被控端配置示例
;  把这个文件复制成 host.ini 放在 ministream-host.exe 旁边即可。
;  也可以直接双击 exe，托盘图标右键 -> 打开配置 里改。
; =============================================================================

[server]
; 监听端口，必须 > 10000。TCP 与 UDP 用同一个端口号。
; FRP 侧要各配一条 TCP 规则和一条 UDP 规则都指向这个端口。
port=14738
backup_port=0

; 双线：备用线路端口（0=不启用）。键鼠走备线，主线全留给视频。
; 客户端 client.ini 里也要配 backup_host/backup_port 指向同一端口
14738

; 访问密码（远控端要填一样的）。留空会被拒绝启动。
password=changeme

; 绑定地址。0.0.0.0 = 所有网卡；只允许局域网时可改成本机内网 IP。
bind=0.0.0.0

[video]
; 帧率：30 / 60 / 120 / 144
fps=60

; 码率 kbps。0 = 按分辨率自适应（1080p60 约 20000）。
bitrate_kbps=0

; 输出分辨率缩放。0 = 跟随原生分辨率。
width=0
height=0

; 编码器：auto / nvenc / amf / qsv / cpu
; auto 会按 nvenc -> amf -> qsv -> cpu 顺序挑第一个可用的。
encoder=auto

; 视频编码格式：h264 / hevc(H.265)
; H.265 同画质下码率约省 30~40%（中继/公网带宽紧张时更流畅），代价是解码端
; 稍费一点 GPU；老显卡没有 HEVC 硬解时会退回软解（CPU 占用高）。
; 连接过程中也可以在远控端工具栏「画质 -> 编码」里热切换，不用改这里。
codec=h264

; 采集哪块显示器（0 = 主显示器）。可以在配置窗口里下拉选择。
monitor=0

; 关键帧间隔（秒）。0 = 按需（推荐）：只在远控端缺帧/换目标时出 IDR。
; 周期 IDR 会造成码率锯齿 → 队列堆积 → 规律性卡顿（实测 24 万帧只有 7 个 I 帧
; 的串流产品就是这么做的）。只有排障需要"固定恢复上限"时才设 1~10 秒。
keyframe_interval_sec=0

[audio]
; 是否把被控端的系统声音（游戏/音乐）传给远控端。
; 用 WASAPI loopback 录"正在播放的混音"，不需要装虚拟声卡。
enabled=true

; 音频码率 kbps（Opus 编码，48kHz 立体声 20ms 一帧）。32~160 都有意义；
; 96 已经比大部分游戏语音清楚，再高对听感提升不明显。
bitrate_kbps=96

[input]
; 是否接收远控端的键鼠注入。
enabled=true

[log]
; 0=Trace 1=Debug 2=Info 3=Warn 4=Error
level=2


