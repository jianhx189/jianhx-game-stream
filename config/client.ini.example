; =============================================================================
;  jianhx 远控端配置示例
;  复制成 client.ini 放在 ministream-client.exe 旁边即可。
;  host / port / password 也可以每次在连接界面里填。
; =============================================================================

[client]
; 被控端的内网 IP 或公网 IP/域名（FRP 转发后的地址）。
; 留空 = 每次在连接面板里填（推荐，避免误连本机）。
host=your-server.example.com

; 被控端端口，必须 > 10000
port=14738

; 验证码，要和被控端一致
password=changeme

; true = 无边框全屏；false = 1280x720 窗口
fullscreen=true

; 关闭窗口时最小化到托盘、程序留在后台（双击托盘图标恢复，右键可退出）
minimize_to_tray=true

; ---- 双线容灾：备用线路（例如第二台 FRP），留空 = 不启用 --------------
; 主线路连不上或会话中途掉线时，自动换这条再试（最多重试 3 次）。
backup_host=
backup_port=0

; 掉线后自动重连（1=开 0=关）
auto_reconnect=1

[video]
; 期望帧率：30 / 60 / 120 / 144（被控端会校验并夹取）
fps=60

; 期望码率 kbps，0 = 让被控端按分辨率自适应
bitrate_kbps=0

; 期望分辨率，0 = 跟随被控端原生分辨率
width=0
height=0

; 画质预设：0=均衡 1=画质优先 2=流畅优先 3=自定义（连接面板的记忆）
preset=0

; 锐化档位：0=关 1=低（默认）2=中 3=高
; 视频编码 + 缩放会糊掉细节，游戏里的字和远处目标尤其明显；客户端在着色器里
; 对亮度做反锐化（色度不动，不会有红绿描边），热生效，不用重连。
; 会话里在「画质」面板改也会记住到下次。
sharpen=1

; 是否记住验证码
remember_password=true

[input]
; 连上后自动捕获键鼠
capture_on_connect=true

; 【键鼠走哪条通道】默认 UDP（每隔几毫秒一包、每包连发 3 份冗余）。
; 不要改成 TCP：TCP 一次丢包重传（RTO 最小 200ms）就会让鼠标"粘住"，
; 实测串流产品的输入延迟能压到 18~22ms 无长尾，前提就是输入不排队。
; 只有视频被迫切到 TCP（说明 UDP 基本不通）时，程序会自动回落到 TCP 输入。

; 释放/重新捕获键鼠的快捷键。捕获状态下按它就能退出捕获（光标回来），
; 再按一次重新捕获。未被捕获时按 ESC 可退出会话。
release_hotkey=CTRL+ALT+SHIFT+Q

; 鼠标模式（重点）：
;   auto（默认）= 自动：被控端光标可见（桌面/游戏菜单）时做绝对映射，
;                 远端光标和你本机鼠标 1:1 重合，不会"乱飘"；
;                 被控端光标被隐藏（游戏内场）时自动切成相对原始位移，
;                 保证 FPS 游戏瞄准手感。
;   absolute = 永远绝对映射（远端光标 = 你的鼠标位置）
;   relative = 永远相对（本机光标隐藏，发原始位移）
mouse_mode=auto

[audio]
; 是否播放被控端的声音（游戏声/音乐）。工具栏「声音」按钮可以随时本机静音，
; 静音期间被控端照常发流，取消静音立刻有声。
enabled=true

[overlay]
; 右上角悬浮状态条（延迟/帧率/码率/丢包率），不遮挡画面中心
enabled=true
; 0=左上 1=右上 2=左下 3=右下
corner=1

[log]
; 0=Trace 1=Debug 2=Info 3=Warn 4=Error
level=2

